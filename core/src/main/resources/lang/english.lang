spells.soullantern.name = &5Soul Lantern
spells.soullantern.description = &7A wisp that follows you, keeps a lamp\n&7overhead and gathers the drops you\n&7left behind. Never another's.

# --- SkyglassGlide (circle 5, AIR, UTILITY) ---
spells.skyglassglide.book_name = &fManual of the Glass Step
spells.skyglassglide.lore1 = &8Fall, but as if the air were a floor.
spells.skyglassglide.lore2 = &8the ground will still be there.
spells.skyglassglide.name = &fSkyglass Glide
spells.skyglassglide.description = &7You drift downward instead of dropping,\n&7carry more speed through the air and\n&7take no fall damage for the duration.

# --- UndertowVeil (circle 5, WATER, UTILITY) ---
spells.undertowveil.book_name = &bCowl of the Drowned Coast
spells.undertowveil.lore1 = &8The tide keeps its own, and it keeps them breathing.
spells.undertowveil.lore2 = &8allies under the same water.
spells.undertowveil.name = &bUndertow Veil
spells.undertowveil.description = &7Draws a veil of water over you and up to two\n&7allies within eight blocks, letting you breathe\n&7and swim faster while it lasts. Snuffs any fire.
spells.undertowveil.active = &bThe veil holds for {seconds}s.

# --- Foldstep (circle 6, NONE, UTILITY) ---
spells.foldstep.book_name = &fNotes on Folding Space
spells.foldstep.lore1 = &8There is no distance between two points you already are.
spells.foldstep.lore2 = &8The destination is always checked before the fold.
spells.foldstep.name = &fFoldstep
spells.foldstep.description = &7Folds you and up to two allies pressed within\n&7three blocks to the furthest safe point ahead,\n&7up to thirty blocks away. Refuses a blind fold.
spells.foldstep.no_destination = &7Nowhere safe lies ahead.

# --- Quarryheart (circle 6, EARTH, TERRAIN) ---
spells.quarryheart.book_name = &aOn the Patience of Stone
spells.quarryheart.lore1 = &8The hill parts for the one who asks in the old way.
spells.quarryheart.lore2 = &8Ores, chests and claims are left untouched.
spells.quarryheart.name = &aQuarryheart
spells.quarryheart.description = &7Cracks the plain stone out of a five block\n&7volume within twenty-four blocks and hands\n&7you the real drops - up to twenty-four pieces.
spells.quarryheart.no_target = &7Nothing solid in reach.
spells.quarryheart.harvested = &aHarvested {count} stone blocks.

# --- PhoenixReprieve (circle 6, FIRE, UTILITY) ---
spells.phoenixreprieve.book_name = &cThe Burning Reprieve
spells.phoenixreprieve.lore1 = &8Ash remembers the shape it used to hold.
spells.phoenixreprieve.lore2 = &8and grants no invulnerability of its own.
spells.phoenixreprieve.name = &cPhoenix Reprieve
spells.phoenixreprieve.description = &7Seals one ally within twenty blocks for forty-five\n&7seconds. The next lethal blow leaves them on four\n&7health instead of killing them. Fewer in PvP.
spells.phoenixreprieve.sealed = &cThe seal holds for {seconds}s.
spells.phoenixreprieve.burned = &cThe seal burned out to save you.

# --- BeaconOfAccord (circle 6, LIGHT, SUSTAIN) ---
spells.beaconofaccord.book_name = &eThe Accord Beacon
spells.beaconofaccord.lore1 = &8A light that asks nothing and mends everyone.
spells.beaconofaccord.lore2 = &8Two curses lifted from each of them.
spells.beaconofaccord.name = &eBeacon of Accord
spells.beaconofaccord.description = &7Plants a beacon that restores eight health to\n&7up to eight allies within twelve blocks and\n&7burns two harmful effects off each of them.
spells.beaconofaccord.mended = &eThe beacon mended {count}.

# --- WraithboundRetinue (circle 6, DARK, UTILITY) ---
spells.wraithboundretinue.book_name = &5The Wraithbound Retinue
spells.wraithboundretinue.lore1 = &8Two shadows that owe you a debt and intend to pay it.
spells.wraithboundretinue.lore2 = &8They never touch a player.
spells.wraithboundretinue.name = &5Wraithbound Retinue
spells.wraithboundretinue.description = &7Calls two wraith sentinels that hang at your\n&7shoulder for forty-five seconds. Each marks the\n&7nearest hostile within eight and cuts it for four\n&7health every three seconds, eight strikes each.

# --- Skyhook (circle 6, AIR, UTILITY) ---
spells.skyhook.book_name = &fTome of the Hooked Sky
spells.skyhook.lore1 = &8&oThe wind answers a rod cast upward.
spells.skyhook.lore2 = &8Lifts the caster and nearby allies, then holds them on a slow fall.
spells.skyhook.name = &fSkyhook
spells.skyhook.description = &7Launches the caster and up to three allies within twelve blocks into the air, then holds them on slow falling for twelve seconds.

# --- RiptideConvoy (circle 6, WATER, BURST) ---
spells.riptideconvoy.book_name = &bCodex of the Riding Tide
spells.riptideconvoy.lore1 = &8&oStand on the wave, not behind it.
spells.riptideconvoy.lore2 = &8Carries the caster and up to four allies forward on a surge.
spells.riptideconvoy.name = &bRiptide Convoy
spells.riptideconvoy.description = &7Rides a five-wide surge forward twenty-eight blocks, carrying the caster and up to four allies and striking everything it washes over once.

# --- WayfarersCall (circle 7, NONE, UTILITY) ---
spells.wayfarerscall.book_name = &fWayfarer's Register
spells.wayfarerscall.lore1 = &8&oCall, and the road comes to you.
spells.wayfarerscall.lore2 = &8Channel five seconds to gather the team to the caster.
spells.wayfarerscall.name = &fWayfarers Call
spells.wayfarerscall.description = &7Channels for five seconds, then pulls up to five allies within sixty-four blocks to the caster's side.\nThe call breaks on damage or movement and the mana is not refunded.
spells.wayfarerscall.answered = &fYour call is answered.

# --- StoneBastion (circle 7, EARTH, DENIAL) ---
spells.stonebastion.book_name = &aCodex of the Standing Wall
spells.stonebastion.lore1 = &8&oGround to stand on, walls to stand behind.
spells.stonebastion.lore2 = &8Raises an eleven-wide refuge with two doors.
spells.stonebastion.name = &aStone Bastion
spells.stonebastion.description = &7Raises an eleven-by-eleven refuge with five-high walls and two doorways, standing for ninety seconds before every block settles back.
spells.stonebastion.raised = &aThe bastion stands for {seconds} seconds.

# --- DragonsWake (circle 7, FIRE, BURST) ---
spells.dragonswake.book_name = &cTome of the Dragon's Wake
spells.dragonswake.lore1 = &8&oTwo breaths, then ash.
spells.dragonswake.lore2 = &8Sends two pulses of fire down a thirty-block lane.
spells.dragonswake.name = &cDragons Wake
spells.dragonswake.description = &7Sends two pulses of dragon fire down a thirty-block lane, striking every enemy in it twice.\nThe fire never lands on a block.

# --- DawnChorus (circle 7, LIGHT, SUSTAIN) ---
spells.dawnchorus.book_name = &eHymnal of the First Light
spells.dawnchorus.lore1 = &8&oSing, and the wounded stand.
spells.dawnchorus.lore2 = &8Heals the team, cleanses two curses each, then mends for six seconds.
spells.dawnchorus.name = &eDawn Chorus
spells.dawnchorus.description = &7Heals up to eight allies within eighteen blocks, lifts two harmful effects from each, then mends one hit point a second for six seconds.
spells.dawnchorus.sung = &eThe chorus mends {count}.

