# ==============================
# Circle 5-9 expansion (wave 5 spells)
#
# Every prefix below is the spell's id with its underscores removed. The prefix is
# a HARDCODED LITERAL in each spell's getSpellBook(); nothing derives it, and
# LangManager.get returns the raw key on a miss, so a typo renders as the literal
# text "spells.foo.book_name" on the item. SpellLangTest pins the convention.
# ==============================

# --- FlameLance (circle 5, FIRE) ---
spells.flamelance.book_name = &eCodex of the Piercing Flame
spells.flamelance.lore1 = &8Draw the breath in, hold it, and loose a lance
spells.flamelance.lore2 = &8narrow enough to pass through an entire crowd.
spells.flamelance.name = &6Flame Lance
spells.flamelance.description = &7A lance of fire narrow enough to pass through a\n&7crowd, burning everything it touches exactly once.

# --- InfernoPilgrimage (circle 7, FIRE) ---
spells.infernopilgrimage.book_name = &6Rite of the Walking Pyre
spells.infernopilgrimage.lore1 = &8The flame does not stand and wait to be struck.
spells.infernopilgrimage.lore2 = &8It walks where you look, and takes three breaths to pass.
spells.infernopilgrimage.name = &6Inferno Pilgrimage
spells.infernopilgrimage.description = &7Loose a wall of flame and it walks the line you\n&7were looking down, taking three pulses as it goes.

# --- SunfireBarrage (circle 8, FIRE) ---
spells.sunfirebarrage.book_name = &eAstral Codex of Falling Light
spells.sunfirebarrage.lore1 = &8Mark what must burn, then hold still and let the
spells.sunfirebarrage.lore2 = &8sun come down on it in pieces.
spells.sunfirebarrage.name = &6Sunfire Barrage
spells.sunfirebarrage.description = &7Hold still and the sun finds five things to\n&7burn. Move, or get hit, and it finds nothing.

# --- InfernoRite (circle 9, FIRE) ---
spells.infernorite.book_name = &6Grimoire of the Ninth Pyre
spells.infernorite.lore1 = &8Wherever your fire has already taken hold, the rite
spells.infernorite.lore2 = &8carries it onward - and the rest of it all goes at once.
spells.infernorite.opened = &6The rite opens. Three charges, and no more.
spells.infernorite.expired = &7The rite closes.
spells.infernorite.name = &6Inferno Rite
spells.infernorite.description = &7For eight seconds, your fire detonates whatever\n&7else is already burning. Three times, and no more.

# --- Undertow (circle 6, WATER) ---
spells.undertow.book_name = &9Tome of the Riptide
spells.undertow.lore1 = &8The sea does not chase. It waits,
spells.undertow.lore2 = &8and then it takes what you owe.
spells.undertow.name = &9Undertow
spells.undertow.description = &7Calls a riptide that hauls one\n&7enemy toward you. The further it\n&7drags them, the more they suffer.

# --- Everdrain (circle 7, WATER) ---
spells.everdrain.book_name = &9Codex of the Leeching Deep
spells.everdrain.lore1 = &8Life is currency, and the water
spells.everdrain.lore2 = &8always comes to collect.
spells.everdrain.name = &9Everdrain
spells.everdrain.description = &7Opens a pool that drinks from\n&7every living thing inside it -\n&7and hands their life to you.

# --- ThousandWaves (circle 8, WATER) ---
spells.thousandwaves.book_name = &9Atlas of a Thousand Waves
spells.thousandwaves.lore1 = &8Call the whole sea, and it comes
spells.thousandwaves.lore2 = &8one wave at a time, and all at once.
spells.thousandwaves.name = &9Thousand Waves
spells.thousandwaves.description = &7Hold to gather the sea, then\n&7release eight crests at once -\n&7each one heavier than the last.

# --- TideOfTheDeep (circle 9, WATER) ---
spells.tideofthedeep.book_name = &9Testament of the Rising Tide
spells.tideofthedeep.lore1 = &8Stand in the flood and it will
spells.tideofthedeep.lore2 = &8carry you. Everything else drowns.
spells.tideofthedeep.name = &9Tide of the Deep
spells.tideofthedeep.description = &7Raises a tide that mends you\n&7alone and drowns all within -\n&7and the deeper it runs, the\n&7harder it comes.

# --- TectonicStrike (circle 6, EARTH) ---
spells.tectonicstrike.book_name = &6Tome of the Shattered Strata
spells.tectonicstrike.lore1 = &8&oBring the mountain down on one point.
spells.tectonicstrike.lore2 = &8a focused slam that breaks the ground open.
spells.tectonicstrike.name = &6Tectonic Strike
spells.tectonicstrike.description = &7Slams the full weight of a mountain into one\n&7point, cracking the ground and hurling everything back.

# --- FaultLine (circle 7, EARTH) ---
spells.faultline.book_name = &4Grimoire of the Split Land
spells.faultline.lore1 = &8&oThe crust remembers every wound.
spells.faultline.lore2 = &8a crack that keeps opening for ten seconds.
spells.faultline.name = &4Fault Line
spells.faultline.description = &7Splits the ground open and keeps splitting it for ten\n&7seconds, hurling anything that falls into the crack.

# --- ContinentalShift (circle 8, EARTH) ---
spells.continentalshift.book_name = &2Atlas of the Rising Land
spells.continentalshift.lore1 = &8&oLift a continent, and stand upon it.
spells.continentalshift.lore2 = &8a plateau raised from the crust, and no scar left behind.
spells.continentalshift.name = &2Continental Shift
spells.continentalshift.description = &7Channels the crust upward into a plateau you can\n&7stand on, and drop off the edge of.

# --- Worldbreaker (circle 9, EARTH) ---
spells.worldbreaker.book_name = &5Last Codex of the Broken World
spells.worldbreaker.lore1 = &8&oThe world was whole, once.
spells.worldbreaker.lore2 = &8two faults, one slab, and everything caught between.
spells.worldbreaker.name = &5Worldbreaker
spells.worldbreaker.description = &7Tears the arena apart along two faults and levers\n&7the slab between them into the air.

# --- Updraft (circle 3, AIR) ---
spells.updraft.book_name = &fTome of Wind &oVol. 3
spells.updraft.lore1 = &8Air itself, taught to lift what it holds.
spells.updraft.lore2 = &8knock upward.
spells.updraft.name = &fUpdraft
spells.updraft.description = &7A column of rising air that tears\n&7enemies off their feet.

# --- Thunderclap (circle 6, AIR) ---
spells.thunderclap.book_name = &fCodex of the Split Sky
spells.thunderclap.lore1 = &8One word of thunder, and the air answers.
spells.thunderclap.lore2 = &8a single concussive blast.
spells.thunderclap.name = &fThunderclap
spells.thunderclap.description = &7A single concussive blast that shoves\n&7everything nearby outward and back.

# --- CycloneNest (circle 7, AIR) ---
spells.cyclonenest.book_name = &fCompendium of the Maelstrom
spells.cyclonenest.lore1 = &8Three small gyres, set down and left to feed.
spells.cyclonenest.lore2 = &8nesting tornadoes.
spells.cyclonenest.name = &fCyclone Nest
spells.cyclonenest.description = &7Set three small tornadoes into the\n&7ground and leave them feeding.

# --- Stormcaller (circle 8, AIR) ---
spells.stormcaller.book_name = &fThe Wandering Tempest
spells.stormcaller.lore1 = &8Call the storm, and hold it to you.
spells.stormcaller.lore2 = &8a storm that follows.
spells.stormcaller.name = &fStormcaller
spells.stormcaller.description = &7Hold still and raise a storm that\n&7follows you, striking what comes close.

# --- Skywrath (circle 9, AIR) ---
spells.skywrath.book_name = &fThe Wrath of Open Sky
spells.skywrath.lore1 = &8The last lesson: take the sky itself.
spells.skywrath.lore2 = &8flight, and a storm to justify it.
spells.skywrath.ending = &7The sky closes. You are grounded again.
spells.skywrath.name = &fSkywrath
spells.skywrath.description = &7Take the sky itself. A storm follows you\n&7for fifteen seconds, and you fly with it.

# --- LightBolt (circle 1, LIGHT) ---
spells.lightbolt.book_name = &eScroll of the First Ray
spells.lightbolt.lore1 = &8The opening line of the lit canticle,
spells.lightbolt.lore2 = &8a single ray loosed at the risen dead.
spells.lightbolt.name = &eLight Bolt
spells.lightbolt.description = &7A pale bolt of gathered light,\n&7hurled straight down your aim.\n&7It bites the risen dead twice as hard.

# --- RadiantBrand (circle 6, LIGHT) ---
spells.radiantbrand.book_name = &6Book of the Sealed Brand
spells.radiantbrand.lore1 = &8Mark a foe, and the light keeps
spells.radiantbrand.lore2 = &8its own accounts.
spells.radiantbrand.no_target = &cNo living target in sight.
spells.radiantbrand.faded = &7The brand fades unlit.
spells.radiantbrand.name = &6Radiant Brand
spells.radiantbrand.description = &7Seal a mark on one foe. It deals\n&7no damage when it is set...\n&7...and everything when it goes out.

# --- ChoirOfLight (circle 7, LIGHT) ---
spells.choiroflight.book_name = &bPsalter of the Shifting Choir
spells.choiroflight.lore1 = &8Every voice in the choir finds its
spells.choiroflight.lore2 = &8own throat, and all of them sing at once.
spells.choiroflight.no_target = &cNothing to sing to.
spells.choiroflight.name = &bChoir of Light
spells.choiroflight.description = &7Shards of light orbit you, find\n&7their own throats, and sing as\n&7one. Answer the choir and it\n&7falls silent all at once.

# --- Apotheosis (circle 8, LIGHT) ---
spells.apotheosis.book_name = &dLitany of the Ascendant
spells.apotheosis.lore1 = &8Stand still while the light climbs,
spells.apotheosis.lore2 = &8and it will climb through you.
spells.apotheosis.active = &dThe ascendant holds for &f%duration%&d seconds.
spells.apotheosis.expired = &7The light settles out of you.
spells.apotheosis.interrupted = &cThe ascent is broken!
spells.apotheosis.already_active = &cYou are already ascended.
spells.apotheosis.boss_bar = &dApotheosis %duration%s
spells.apotheosis.name = &dApotheosis
spells.apotheosis.description = &7Stand still while the light climbs,\n&7and it will climb through you.\n&7Your own spells cost less and hit\n&7harder while it holds.

# --- CrownOfDawn (circle 9, LIGHT) ---
spells.crownofdawn.book_name = &fCrown of the Breaking Dawn
spells.crownofdawn.lore1 = &8A wall of morning stands where
spells.crownofdawn.lore2 = &8you tell it to, and nothing crosses.
spells.crownofdawn.broken = &cThe crown of dawn is broken!
spells.crownofdawn.name = &fCrown of Dawn
spells.crownofdawn.description = &7A wall of morning stands where\n&7you tell it to. Nothing crosses,\n&7and the weakened do not leave it.

# --- UmbralVolley (circle 7, DARK) ---
spells.umbralvolley.book_name = &5Umbral Volley &oChapter III
spells.umbralvolley.lore1 = &8&oThree darts of night, and the wound they
spells.umbralvolley.lore2 = &8leave behind them does not close.
spells.umbralvolley.name = &5Umbral Volley
spells.umbralvolley.description = &7Loose three darts of shadow that hunt\n&7the same prey, then split apart\n&8&oand leave a wound that will not close.

# --- VoidAnchor (circle 8, DARK) ---
spells.voidanchor.book_name = &5Grimoire of the Bound &oFolio IV
spells.voidanchor.lore1 = &8&oTear a horror from the ground and set it
spells.voidanchor.lore2 = &8to hold what you would not hold yourself.
spells.voidanchor.no_summon_spot = &cThe ground will not give one up here.
spells.voidanchor.name = &5Void Anchor
spells.voidanchor.description = &7Tear a bound horror from the ground\n&7and set it to hold what comes\n&7within its reach.

# --- Oblivion (circle 9, DARK) ---
spells.oblivion.book_name = &5Necronomicon Finis
spells.oblivion.lore1 = &8&oWhat is already dying is easiest to erase;
spells.oblivion.lore2 = &8a soul at its last leaves the least behind.
spells.oblivion.no_target = &cNothing stands close enough to be forgotten.
spells.oblivion.name = &5Oblivion
spells.oblivion.description = &7Erase one soul. The closer it\n&7already is to the dark, the\n&7less of it there is to remove.

# --- ArcaneWard (circle 5, NONE) ---
spells.arcaneward.book_name = &5Aegis Codex &oPart II
spells.arcaneward.lore1 = &8&oSet the aegis where it is needed, not where you stand.
spells.arcaneward.lore2 = &8stationary ally-buffersing.
spells.arcaneward.name = &5Arcane Ward
spells.arcaneward.description = &7Weaves a screen of mana around one\n&7soul - yours or an ally's - and\n&7leaves it standing when you walk away.

# --- WaystoneRecall (circle 7, NONE) ---
spells.waystonerecall.book_name = &dCodex of the Bound Waystone
spells.waystonerecall.lore1 = &8&oThe waystone does not ask for a moment.
spells.waystonerecall.lore2 = &8instantaneous long-range recall.
spells.waystonerecall.no_points = &cYou have no reachable waystones! Set some in Warp's options first.
spells.waystonerecall.nothing_in_sight = &cNo waystone within reach of your aim.
spells.waystonerecall.blocked = &cYou cannot recall there!
spells.waystonerecall.name = &dWaystone Recall
spells.waystonerecall.description = &7Names a waystone, and stands you\n&7on it before the sound has\n&7finished - no channel, no window.

# --- EchoCast (circle 8, NONE) ---
spells.echocast.book_name = &dGrimoire of the Repeated Hour
spells.echocast.lore1 = &8&oWhat you cast, cast once more.
spells.echocast.lore2 = &8re-casts the last three spells in order.
spells.echocast.no_history = &cYou have not cast anything to echo yet.
spells.echocast.not_enough_mana = &cNot enough mana to echo your last three spells.
spells.echocast.replaying = &dEchoing &f%count% &dspell(s)...
spells.echocast.name = &6Echo Cast
spells.echocast.description = &7Takes the last three things you cast\n&7and makes you cast them again,\n&7in order, for sixty percent.

# --- ArcaneResonance (circle 9, NONE) ---
spells.arcaneresonance.book_name = &5Tome of the Standing Wave
spells.arcaneresonance.lore1 = &8&oHold the note. The spell answers twice.
spells.arcaneresonance.lore2 = &8the next three casts sound at a fifth more.
spells.arcaneresonance.armed = &dResonance armed - &f%count% &dcasts amplified.
spells.arcaneresonance.charges = &dResonance - &f%count% &dcast(s) remain.
spells.arcaneresonance.spent = &7Your resonance has spent itself.
spells.arcaneresonance.expired = &7Your resonance faded unused.
spells.arcaneresonance.already_active = &cYou are already resonating!
spells.arcaneresonance.name = &dArcane Resonance
spells.arcaneresonance.description = &7Sets your next three casts ringing\n&7true - each one sounds twice,\n&7at a fifth more than it should.

# --- Dispel (circle 3, LIGHT, UTILITY) ---
spells.dispel.book_name = &eScroll of the Unwritten Word
spells.dispel.lore1 = &8Every working leaves a mark.
spells.dispel.lore2 = &8yours, or theirs - if your circle is deep enough.
spells.dispel.cleared = &eDispelled &f%cleared% &eeffect(s).
spells.dispel.resisted = &8%resisted% &7effect(s) held firm.
spells.dispel.nothing = &8Nothing here answers to your circle.
spells.dispel.name = &eDispel
spells.dispel.description = &7Strips the buffs, debuffs and illusions\n&7carrying a single target. Out-ranks each\n&7one by circle.

