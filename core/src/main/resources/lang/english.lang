# ==============================
# SPELL NAMES AND DESCRIPTIONS
# ==============================
# A spell's name and description live here, not in spells/<id>.yml. Each spell owns one
# block keyed by its id with the underscores removed, so fire_blast and earth_spike are
# spells.fireblast.* and spells.earthspike.*.
#
# This file shadows the copy bundled in the jar, so edit it freely and run
# /alkatraz reload to apply it. Do not delete it: the bundled copy is written back on
# the next server start and any edits go with it.
#
# Colour codes: &a and friends for the legacy codes, #RRGGBB for hex. A hex code carries
# no ampersand in front of it - &#RRGGBB is not a valid form in a lang file and leaves a
# stray & in the output. See spells.earthspike.name further up for a hex example.
#
# A value is a single line. This format has no line continuations, so a value wrapped
# across two physical lines is silently cut at the break. Use the two characters
# backslash and n to make a description span several lines, and repeat the colour code
# on every segment:
#   spells.fireball.description = &7A small ball of fire that can be shot\n&7at an enemy.
#
# Every spell's real .name and .description keys sit in that spell's own block further up
# this file; the line above only shows the shape. spells.<prefix>.book_name is a
# different string - the title of the book the spell is learned from - and neither it nor
# the name comes from the spell's yml any more.

# ==============================
# RESEARCH OVERRIDES (optional)
# ==============================
# research.yml nodes and categories can be renamed from here. Uncomment or add keys.
# Format: override.research.<type>.<id>.<field>
# ==============================
# override.research.nodes.<id>.name = &aCustom Name
# override.research.nodes.<id>.description = &7Custom description line 1\nCustom description line 2
# override.research.categories.<id>.name = &aCustom Category Name
commands.modifier_usage = &cUsage: /alkatraz modifier grant|revoke|list|inspect [player]
commands.modifier_revoked = &aRevoked modifier.
commands.modifier_not_found = &cModifier not found.
commands.modifier_list_empty = &7No active modifiers.
commands.effect_list_empty = &7No active effects.
commands.booster_usage = &cUsage: /alkatraz booster start|stop|list [world|group] [target] [multiplier]
commands.booster_started = &aStarted booster for %scope% %target% (x%multiplier%).
commands.booster_failed = &cFailed to start booster for %scope% %target%.
commands.booster_stopped = &aStopped booster for %scope% %target%.
commands.booster_not_found = &cNo active booster for %scope% %target%.
commands.booster_list_empty = &7No active boosters.# Booster announcements
boosters.announce_start = &a[Booster] &f%name% &7started (%multiplier%x for %duration%).
boosters.announce_stop = &c[Booster] &f%name% &7has ended.
boosters.title_start = %name%
boosters.subtitle_start = &7%multiplier%x for %duration%
boosters.countdown_title = &e%seconds%s
boosters.countdown_subtitle = &7%name% ending
boosters.chat_format = &6[Booster] &f%name% &7- &e%multiplier%x &8(%source%)

spells.veiloftheunseencourt.book_name = &5Veil of the Unseen Court
spells.veiloftheunseencourt.lore1 = &8&oThe court passes, and nothing sees it go.
spells.veiloftheunseencourt.lore2 = &8Hostile eyes slide from those it cloaks.
spells.veiloftheunseencourt.name = &5Veil of the Unseen Court
spells.veiloftheunseencourt.description = &7Conceals the caster and up to four allies from\n&7hostile mobs for twenty-five seconds. The veil\n&7breaks for a bearer who attacks or casts offensively.
spells.veiloftheunseencourt.veiled = &5The unseen court veils you for {seconds}s.
spells.veiloftheunseencourt.broken = &5Your veil tears as you strike.
spells.veiloftheunseencourt.ended = &5The veil of the unseen court fades.
spells.tempestroad.book_name = &fCodex of the Tempest Road
spells.tempestroad.lore1 = &8&oThe wind remembers the way forward.
spells.tempestroad.lore2 = &8&oStep in and let the gale carry you.
spells.tempestroad.name = &fTempest Road
spells.tempestroad.description = &7Conjures a thirty-six by six wind lane\n&7for thirty seconds that carries players\n&7along it and grants slow falling on exit.
spells.leviathanspassage.book_name = &bCodex of the Leviathan
spells.leviathanspassage.lore1 = &8&oThe deep carries those it claims.
spells.leviathanspassage.lore2 = &8Summons a spectral mount for the caster and consenting allies.
spells.leviathanspassage.name = &bLeviathans Passage
spells.leviathanspassage.description = &7Summons a spectral leviathan for forty-five seconds, carrying the caster and up to two consenting allies at 1.5x speed with Water Breathing.
spells.leviathanspassage.summoned = &bThe leviathan rises to bear you.
# --- ChronicleAnchor (circle 8, NONE, UTILITY) ---
spells.chronicleanchor.book_name = &fChronicle of the Return
spells.chronicleanchor.lore1 = &8&oA place remembered is a place you can keep.
spells.chronicleanchor.lore2 = &8Set an anchor, then return before it fades.
spells.chronicleanchor.name = &fChronicle Anchor
spells.chronicleanchor.description = &7Records a safe location for 120 seconds.\n&7Recast within the window to return with up to three consenting allies.\n&7The anchor is consumed on return.
spells.chronicleanchor.anchor_set = &fAnchor set for {seconds} seconds.
spells.chronicleanchor.returned = &fThe chronicle returns you.
spells.chronicleanchor.no_safe_location = &7You cannot anchor here.
spells.chronicleanchor.destination_unsafe = &7The anchor no longer holds a safe place.
spells.chronicleanchor.mark = &fAnchor
# --- TitansCauseway (circle 8, EARTH, TERRAIN) ---
spells.titanscauseway.book_name = &aTablet of the Titan's March
spells.titanscauseway.lore1 = &8A road laid where no road should hold.
spells.titanscauseway.lore2 = &8It spans the gap until the stone remembers to fall.
spells.titanscauseway.name = &aTitans Causeway
spells.titanscauseway.description = &7Raises a stone causeway at your height\n&7up to forty-eight blocks long and five wide,\n&7bridging gaps for two minutes.
spells.titanscauseway.raised = &aThe causeway stands for {seconds} seconds.
spells.starfallcrucible.book_name = &cTome of the Starfall Crucible
spells.starfallcrucible.lore1 = &8&oThree falls, one after another.
spells.starfallcrucible.lore2 = &8Calls comets into an area. Safe ascent belongs to Circle 9.
spells.starfallcrucible.name = &cStarfall Crucible
spells.starfallcrucible.description = &7Calls three comets to strike within a wide area over six seconds.\n&7Comets burn foes without breaking blocks or starting fires.\n&7Safe ascent belongs to Infernal Sovereignty at Circle 9.

spells.worldtreebeacon.book_name = &eCodex of the Worldtree
spells.worldtreebeacon.lore1 = &8&oRoots remember the sky they came from.
spells.worldtreebeacon.lore2 = &8Plants a beacon that mends allies who hold its ground.
spells.worldtreebeacon.name = &eWorldtree Beacon
spells.worldtreebeacon.description = &7Plants a luminous worldtree for eighteen seconds.\n&7Up to eight allies within twenty blocks heal 1 HP per second\n&7and hold four absorption while they stay inside.
spells.worldtreebeacon.planted = &eThe worldtree takes root for {seconds} seconds within {radius} blocks.
spells.worldtreebeacon.expired = &7The worldtree's light fades.
spells.worldtreebeacon.mark = &eWorldtree

spells.soulreclamation.book_name = &5Grimoire of the Returned
spells.soulreclamation.lore1 = &8&oWhat the veil swallowed, the veil remembers.
spells.soulreclamation.lore2 = &8Returns you to your last death and calls your drops back.
spells.soulreclamation.name = &5Soul Reclamation
spells.soulreclamation.description = &7Returns you to your most recent death within 128 blocks\n&7and pulls your own dropped stacks within ten blocks\n&7into your inventory. The trail is only good for ten minutes.
spells.soulreclamation.mark = &5Your last death
spells.soulreclamation.reclaimed = &5The veil returns {count} of your stacks.
spells.soulreclamation.empty = &7The veil returns you, but nothing of yours remains here.
spells.soulreclamation.no_death = &7You have no death trail to follow.
spells.soulreclamation.wrong_world = &7Your death trail lies in another world.
spells.soulreclamation.too_far = &7Your death trail is beyond the reach of this spell.
spells.soulreclamation.too_old = &7Your death trail has gone cold.
spells.soulreclamation.chunk_unloaded = &7The place of your death is not loaded.

spells.eyeofthefirmament.book_name = &fCodex of the Open Sky
spells.eyeofthefirmament.lore1 = &8&oThe sky lends its freedom, and takes its due.
spells.eyeofthefirmament.lore2 = &8Grants controlled flight to the caster and three allies.
spells.eyeofthefirmament.name = &fEye of the Firmament
spells.eyeofthefirmament.description = &7Opens an eye in the upper air and lends flight\n&7to you and up to three team allies for twenty-two seconds.\n&7Melee and offensive spells are sealed until you land.
spells.eyeofthefirmament.granted = &fThe firmament lifts you for {seconds} seconds.
spells.eyeofthefirmament.ended = &7The borrowed sky sets you down.
spells.eyeofthefirmament.melee_blocked = &7The firmament forbids violence until you land.
spells.eyeofthefirmament.spell_blocked = &7The firmament seals offensive magic until you land.

spells.tidalreservoir.book_name = &9Codex of the Breaking Tide
spells.tidalreservoir.lore1 = &8&oThe reservoir remembers the river it was.
spells.tidalreservoir.lore2 = &8Breaks a controlled channel across the land.
spells.tidalreservoir.name = &9Tidal Reservoir
spells.tidalreservoir.description = &7Breaks open a water channel up to thirty-six blocks long\n&7and six wide for ninety seconds. It carries boats and swimmers,\n&7douses fire, waters farmland, and then restores the land.
spells.tidalreservoir.raised = &9The reservoir breaks open for {seconds} seconds.
spells.tidalreservoir.expired = &7The water recedes and the land remembers itself.

spells.worldgate.book_name = &fCodex of the Unbroken Road
spells.worldgate.lore1 = &8&oDistance is a courtesy, not a law.
spells.worldgate.lore2 = &8Tears a paired portal through the same world.
spells.worldgate.name = &fWorld Gate
spells.worldgate.description = &7Records an origin, then opens a paired portal at your\n&7second cast within three minutes and 512 blocks.\n&7Both gates hold for sixty seconds and carry up to eight players.
spells.worldgate.origin_set = &fOrigin recorded. Cast again at the destination within three minutes.
spells.worldgate.opened = &fThe gates open. Up to {players} may pass before they close.
spells.worldgate.closed = &7The gates collapse and the road is gone.
spells.worldgate.no_origin = &7No origin is armed. Cast once to record one.
spells.worldgate.expired = &7The origin has faded. Cast once to record a new one.
spells.worldgate.wrong_world = &7A gate cannot cross between worlds.
spells.worldgate.too_far = &7The destination is beyond the reach of this gate.
spells.worldgate.too_close = &7The destination is too close to the origin.
spells.worldgate.unsafe_destination = &7The gate cannot open here.

spells.atlasunbound.book_name = &2Codex of the Held World
spells.atlasunbound.lore1 = &8&oThe world was carried once; it can be lifted again.
spells.atlasunbound.lore2 = &8Raises the land into broad stone terraces.
spells.atlasunbound.name = &2Primordial Bastion
spells.atlasunbound.description = &7Raises a thirty-two block square of land into four stone\n&7terraces up to twelve blocks high for three minutes.\n&7It never digs, and the land settles back when it ends.
spells.atlasunbound.raised = &2The land rises and holds for {seconds} seconds.
spells.atlasunbound.expired = &7The terraces settle back into the world.
spells.atlasunbound.no_room = &7There is nowhere here for the land to rise.

spells.starfallcataclysm.book_name = &cCodex of the Falling Sky
spells.starfallcataclysm.lore1 = &8&oThe sky keeps a debt of stars.
spells.starfallcataclysm.lore2 = &8Calls three star-fragments down on a marked radius.
spells.starfallcataclysm.name = &cInfernal Sovereignty
spells.starfallcataclysm.description = &7Marks a thirty-two block radius, then calls down three\n&7star-fragments. Each impact scorches everything nearby\n&7without breaking blocks or starting fires, and leaves a\n&7safe eight-second updraft for you and consenting allies.
spells.starfallcataclysm.mark = &cThe sky is watching here

spells.covenantofthefirstdawn.book_name = &eCodex of the First Dawn
spells.covenantofthefirstdawn.lore1 = &8&oThe first light promised it would not go out.
spells.covenantofthefirstdawn.lore2 = &8Wards up to ten allies against one lethal blow.
spells.covenantofthefirstdawn.name = &eEmpyrean Ascendance
spells.covenantofthefirstdawn.description = &7Heals up to ten allies within twenty-four blocks,\n&7cleanses every harmful effect, and grants a forty-five second\n&7ward that turns one lethal hit into a single point of health.
spells.covenantofthefirstdawn.warded = &eThe dawn holds you for {seconds} seconds.
spells.covenantofthefirstdawn.ward_spent = &eThe dawn spends itself. One breath remains.

spells.hollowkingscourt.book_name = &5Codex of the Hollow Throne
spells.hollowkingscourt.lore1 = &8&oA crown with nobody left to wear it.
spells.hollowkingscourt.lore2 = &8Raises four spectral knights and a shadow domain.
spells.hollowkingscourt.name = &5Umbral Oblivion
spells.hollowkingscourt.description = &7Creates an eighteen block shadow domain for thirty\n&7seconds and raises four spectral knights. They engage foes,\n&7never hunt players, and break no ground where they strike.
spells.hollowkingscourt.opened = &5The hollow court holds for {seconds} seconds.

spells.empyreanpassage.book_name = &fCodex of the Open Road
spells.empyreanpassage.lore1 = &8&oThe wind remembers every road it has crossed.
spells.empyreanpassage.lore2 = &8Carries the caster and seven allies on a wind passage.
spells.empyreanpassage.name = &fCelestial Expanse
spells.empyreanpassage.description = &7Opens a wind passage up to ninety-six blocks away.\n&7It carries you and up to seven allies over eight seconds,\n&7tearing through anything caught in the slipstream.
spells.empyreanpassage.opened = &fThe wind takes {riders} of you.
spells.empyreanpassage.arrived = &fThe passage sets you down.
spells.empyreanpassage.attack_blocked = &7The wind will not carry a drawn blade.
spells.empyreanpassage.spell_blocked = &7The passage seals offensive magic until you arrive.
spells.empyreanpassage.interrupted = &7The wind loses its hold.
spells.empyreanpassage.no_room = &7There is no room for a passage here.

spells.leviathanstestament.book_name = &9Codex of the Drowned Crown
spells.leviathanstestament.lore1 = &8&oThe sea keeps what it is owed.
spells.leviathanstestament.lore2 = &8Sends a tidal front forward with the caster riding it.
spells.leviathanstestament.name = &9Abyssal Dominion
spells.leviathanstestament.description = &7Sends a tidal front sixty blocks long and fourteen\n&7wide, built from real water. It batters and shoves everything\n&7in its path, allies included, then the land returns.
spells.leviathanstestament.opened = &9The testament breaks forward.
spells.leviathanstestament.surfaced = &9The water remains for {seconds} seconds.
